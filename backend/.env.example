# Environment mode (development | production | test)
ENVIRONMENT=development
DEBUG=true

# Database Path (for local SQLite)
DATABASE_PATH=./data/growww.db

# For Render persistent disk in production:
# DATABASE_PATH=/var/data/growww.db

# Allowed CORS origins (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server port (defaults to 8000 locally, dynamically assigned by $PORT on Render)
PORT=8000
